&lis2dh12 {
    int1-gpio-config = <0x03>;
    anym-mode = <0x00>;
    anym-on-int1;
    anym-no-latch;
};

&lps22hb_press {
    status = "disabled";
};

&hts221 {
    status = "disabled";
};

&ccs811 {
    status = "disabled";
};

&spk_pwr {
    status = "disabled";
};

&uart0 {
    status = "disabled";
};

/ {
    snes_gamepad: snes-gamepad {
	status = "okay";
        compatible = "dmv,snes-gamepad";
        latch-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
        clock-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
        data-gpios  = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        polling-interval-ms = <10>;
    };
};
